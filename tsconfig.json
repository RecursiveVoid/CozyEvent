{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "noEmit": false,
    "declaration": false,
    "paths": {
      "cozyevent": ["./src/index.ts"],
      "cozyevent/react": ["./src/react/index.ts"]
    }
  },
  "include": ["src"]
}
