{
  "name": "cozyevent",
  "version": "2.0.0",
  "description": "Tiny (448 B min+gzip), fast, fully typed event emitter (sync + microtask async) with an optional one-hook React binding. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.d.cts",
    "dist/react.js",
    "dist/react.cjs",
    "dist/react.d.ts",
    "dist/react.d.cts"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && rollup -c",
    "size": "node scripts/size.js",
    "prepublishOnly": "npm test && npm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "benchmark": "node benchmark/run.js"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "event-emitter",
    "eventemitter",
    "events",
    "emitter",
    "pubsub",
    "emit",
    "on",
    "once",
    "off",
    "async",
    "microtask",
    "typescript",
    "typed",
    "tiny",
    "lightweight",
    "fast",
    "react",
    "react-hook",
    "useCozyEvent"
  ],
  "author": "M. Ergin Turk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RecursiveVoid/CozyEvent.git"
  },
  "devDependencies": {
    "@braintree/event-emitter": "^2.0.2",
    "@protobufjs/eventemitter": "^1.1.0",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@rollup/plugin-wasm": "^6.2.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.12",
    "benchmark": "^2.1.4",
    "emitix": "^2.3.2",
    "event-emitter": "^0.3.5",
    "eventemitter2": "^6.4.9",
    "eventemitter3": "^5.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "react": "^19.1.0",
    "rollup": "^4.27.4",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-strip": "^1.2.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tseep": "^1.3.1",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3"
  }
}
